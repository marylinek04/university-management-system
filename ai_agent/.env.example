# =============================================================================
# University Operations AI Agent - environment configuration
#
# Copy this file to ".env" (same directory) and fill in the values you need.
# docker-compose.yml automatically loads ".env". Never commit your real ".env"
# file or real API keys to version control.
# =============================================================================

# -----------------------------------------------------------------------
# Layer 3 - LLM provider (Required Tools / Orchestration reasoning core)
# -----------------------------------------------------------------------
# Ollama is the DEFAULT and REQUIRED backend for standard execution - it
# runs fully offline/local, needs NO API key, and is what `docker compose
# up --build` starts automatically (see docker-compose.yml: "ollama" and
# "ollama-pull" services). OpenAI/Anthropic are OPTIONAL fallback providers,
# only used if you explicitly set LLM_PROVIDER below AND the matching
# *_API_KEY - they are never required to run, test, or grade this project.
#
# One of: ollama (default, required) | openai (optional fallback) | anthropic (optional fallback)
LLM_PROVIDER=ollama

# Model name. Leave blank to use the per-provider default:
#   ollama    -> llama3.1   (default, required path)
#   openai    -> gpt-4o-mini   (optional fallback)
#   anthropic -> claude-3-5-haiku-20241022   (optional fallback)
LLM_MODEL=

# Sampling temperature (0.0 - 1.0). Lower = more deterministic (recommended
# for reproducible grading/eval runs).
LLM_TEMPERATURE=0.1

# -----------------------------------------------------------------------
# Ollama connection (used when LLM_PROVIDER=ollama, the default)
# -----------------------------------------------------------------------
# Local install (running `python -m app.db.init_db` / `streamlit run` on
# your host without Docker):
OLLAMA_BASE_URL=http://localhost:11434
#
# Docker (docker compose up --build): docker-compose.yml overrides this to
# http://ollama:11434 automatically so the agent container reaches the
# bundled "ollama" service over the Compose network - you normally don't
# need to change this value yourself.

# -----------------------------------------------------------------------
# OPTIONAL FALLBACK providers - leave blank unless you set
# LLM_PROVIDER=openai or LLM_PROVIDER=anthropic above. NOT required for
# default (Ollama) execution, testing, or Docker.
# -----------------------------------------------------------------------
# Only used if LLM_PROVIDER=openai
OPENAI_API_KEY=

# Only used if LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=

# -----------------------------------------------------------------------
# Database
# -----------------------------------------------------------------------
# Path to the SQLite database file. The agent creates and seeds this file
# automatically on first run if it does not exist. docker-compose mounts a
# named volume at /app/data and sets this for you - usually leave unset.
# DATABASE_PATH=/app/data/university.db

# -----------------------------------------------------------------------
# Workflow / safety controls (Layer 2 - orchestration)
# -----------------------------------------------------------------------
# Maximum number of intent-classification iterations per user turn before
# the workflow forces a fallback response.
MAX_ITERATIONS=6

# Minimum confidence (0.0 - 1.0) required to act on a classified intent.
# Below this, the agent returns the "outside my supported domain" fallback.
INTENT_CONFIDENCE_THRESHOLD=0.4

# -----------------------------------------------------------------------
# Logging
# -----------------------------------------------------------------------
# One of: DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO

# -----------------------------------------------------------------------
# Long-term memory (bonus)
# -----------------------------------------------------------------------
# Enable per-user preference storage (favorite courses, report settings, etc.)
ENABLE_LONG_TERM_MEMORY=true
