      "user_role": "student",
      "turns": [
        {
          "message": "I'd like to enroll in CE205 for Spring 2026.",
          "expected_intent": "enrollment_request",
          "expected_tools": [
            "analyze_enrollment_eligibility",
            "create_enrollment_request"
          ],
          "response_contains": [
            "Yousef Khalil",
            "CE205",
            "eligible",
            "confirm"
          ],
          "expect_eligible": true,
          "expect_pending_confirmation": true,
          "expect_fallback": false
        },
        {
          "message": "Yes, please proceed.",
          "expected_intent": "confirm_yes",
          "expected_tools": [
            "create_enrollment_request"
          ],
          "response_contains": [
            "Yousef Khalil",
            "CE205",
            "enrolled",
            "1200.00",
            "3800.00"
          ],
          "expect_confirm_with": {
            "tool": "create_enrollment_request",
            "confirm": true
          },
          "expect_fallback": false
        }
      ]
    },
