      "description": "Duplicate/conflicting action: student already enrolled in CE410 (seed data) asks to enroll again and insists. The re-validation on confirm=True must reject it - no duplicate enrollment row.",
      "user_name": "Nour Hamad",
      "user_role": "student",
      "turns": [
        {
          "message": "Enroll me in CE410 for Spring 2026.",
          "expected_intent": "enrollment_request",
          "expected_tools": [
            "analyze_enrollment_eligibility",
            "create_enrollment_request"
          ],
          "response_contains": [
            "already enrolled"
          ],
          "expect_eligible": false,
          "expect_pending_confirmation": true,
          "expect_fallback": false
