      "id": "LOWCONF-01",
      "category": "low_confidence_clarification",
      "description": "A vague message with no actionable content. The agent should either ask a clarifying question or fall back gracefully - it must NOT call any tool or fabricate information. This case is scored leniently (not counted toward tool-selection accuracy) because exact LLM phrasing/confidence varies.",
      "user_name": "Maryline Karam",
      "user_role": "student",
      "lenient": true,
      "turns": [
        {
          "message": "hmm, can you help me with that thing?",
          "expected_intent": null,
          "expected_tools": [],
          "response_contains": [],
          "expect_fallback": null,
          "notes": "Acceptable outcomes: fallback with the policy refusal message, OR a clarifying question. Either way, no tool may be called and final_response must be non-empty."
        }
      ]
    },
